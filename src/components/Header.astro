---
import { t, localizePath, type Locale } from "@i18n";
import { getLocalizedHrefs } from "@lib/alternates";

type Props = {
  locale?: Locale;
};

const { locale = "en" } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { key: "nav.home", href: "/" },
  { key: "nav.blog", href: "/blog" },
  { key: "nav.work", href: "/work" },
  { key: "nav.projects", href: "/projects" },
] as const;

const { en: enHref, fr: frHref } = await getLocalizedHrefs(pathname);
---

<header class="site-header">
  <nav class="glass-nav" aria-label="Main navigation">
    <span class="nav-pill" aria-hidden="true"></span>
    {links.map((item) => {
      const href = localizePath(item.href, locale);
      const active =
        pathname === href ||
        (item.href !== "/" && pathname.startsWith(href));

      return (
        <a
          href={href}
          class:list={["nav-item", { active }]}
          aria-current={active ? "page" : undefined}
        >
          {t(locale, item.key)}
        </a>
      );
    })}
    <span class="nav-divider" aria-hidden="true"></span>
    <a
      href={enHref}
      class:list={["nav-item", "lang-item", { active: locale === "en" }]}
      aria-current={locale === "en" ? "true" : undefined}
      lang="en"
      hreflang="en"
    >
      EN
    </a>
    <a
      href={frHref}
      class:list={["nav-item", "lang-item", { active: locale === "fr" }]}
      aria-current={locale === "fr" ? "true" : undefined}
      lang="fr"
      hreflang="fr"
    >
      FR
    </a>
  </nav>
</header>

<script>
  let cleanupNav: (() => void) | undefined;

  function initNavPill() {
    cleanupNav?.();
    cleanupNav = undefined;

    const nav = document.querySelector<HTMLElement>(".glass-nav");
    const pill = nav?.querySelector<HTMLElement>(".nav-pill");
    const items = nav
      ? Array.from(nav.querySelectorAll<HTMLAnchorElement>(".nav-item"))
      : [];

    if (!nav || !pill || items.length === 0) return;

    const active =
      nav.querySelector<HTMLAnchorElement>(".nav-item.active") ?? items[0];
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
    const controller = new AbortController();
    const { signal } = controller;

    const place = (element: HTMLAnchorElement, animate: boolean) => {
      if (element.offsetWidth === 0) return;

      if (!animate) pill.style.transition = "none";
      pill.style.width = `${element.offsetWidth}px`;
      pill.style.transform = `translateX(${element.offsetLeft}px)`;

      if (!animate) {
        void pill.offsetWidth;
        pill.style.transition = "";
      }
    };

    place(active, false);
    nav.classList.add("is-ready");

    const follow = (element: HTMLAnchorElement) => {
      if (canHover.matches) place(element, true);
    };

    items.forEach((item) => {
      item.addEventListener(
        "pointerenter",
        (event) => {
          if (event.pointerType === "mouse") follow(item);
        },
        { signal },
      );
      item.addEventListener(
        "focus",
        () => {
          if (canHover.matches) follow(item);
        },
        { signal },
      );
    });

    nav.addEventListener(
      "pointerleave",
      (event) => {
        if (event.pointerType === "mouse") place(active, true);
      },
      { signal },
    );

    const reposition = () => place(active, false);

    window.addEventListener("resize", reposition, { signal });
    window.addEventListener("pageshow", reposition, { signal });

    document.fonts?.ready.then(reposition).catch(() => {});

    const observer = new ResizeObserver(reposition);
    observer.observe(nav);

    cleanupNav = () => {
      controller.abort();
      observer.disconnect();
    };
  }

  document.addEventListener("astro:page-load", initNavPill);
</script>

<style>
  .site-header {
    position: sticky;
    top: 20px;
    z-index: 100;

    display: flex;
    justify-content: center;

    width: 100%;
    padding: 0 12px;
  }

  .glass-nav {
    position: relative;

    display: flex;
    align-items: center;
    gap: clamp(1px, 0.5vw, 4px);
    padding: clamp(4px, 1vw, 6px);
    max-width: calc(100vw - 24px);

    border: 1px solid rgba(128, 128, 128, 0.18);
    border-radius: 9999px;

    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.035);

    transform-origin: top center;
    transition: transform 350ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(html.scrolled) .glass-nav {
    transform: scale(0.9);
  }

  .nav-pill {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 0;

    border-radius: 9999px;
    background: rgba(128, 128, 128, 0.12);
    pointer-events: none;

    opacity: 0;
  }

  .glass-nav.is-ready .nav-pill {
    opacity: 1;
    transition:
      transform 320ms cubic-bezier(0.4, 0, 0.2, 1),
      width 320ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 180ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-item {
    position: relative;

    padding: 9px clamp(5px, 1.6vw, 16px);
    border-radius: 9999px;

    font-size: clamp(10px, 2.7vw, 13px);
    font-weight: 500;
    line-height: 1.2;
    color: #666;
    text-decoration: none;
    white-space: nowrap;

    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;

    transition:
      transform 320ms cubic-bezier(0.4, 0, 0.2, 1),
      color 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-item.active {
    color: #111;
  }

  .nav-item:focus-visible {
    outline: 2px solid rgba(17, 17, 17, 0.55);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-item:hover {
      color: #111;
      transform: translateY(-2px);
    }
  }

  .nav-divider {
    width: 1px;
    height: 18px;
    margin: 0 clamp(2px, 0.6vw, 4px);
    background: rgba(128, 128, 128, 0.25);
    flex-shrink: 0;
  }

  .lang-item {
    padding: 9px clamp(5px, 1.1vw, 12px);
    font-size: clamp(9.5px, 2.4vw, 12px);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* Dark mode */
  :global(.dark) .glass-nav {
    background: rgba(25, 25, 28, 0.5);
    border-color: rgba(255, 255, 255, 0.12);
  }

  :global(.dark) .nav-pill {
    background: rgba(255, 255, 255, 0.1);
  }

  :global(.dark) .nav-item {
    color: #aaa;
  }

  :global(.dark) .nav-item.active {
    color: #fff;
  }

  :global(.dark) .nav-item:focus-visible {
    outline-color: rgba(255, 255, 255, 0.65);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.dark) .nav-item:hover {
      color: #fff;
    }
  }

  :global(.dark) .nav-divider {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 360px) {
    .site-header {
      padding: 0 8px;
    }

    .glass-nav {
      max-width: calc(100vw - 16px);
      padding: 4px;
    }

    .nav-pill {
      top: 5px;
      bottom: 5px;
    }

    .nav-item {
      padding-block: 8px;
      font-size: 10px;
    }

    .lang-item {
      padding-block: 8px;
      font-size: 9.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-item,
    .glass-nav,
    .glass-nav.is-ready .nav-pill {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) and (hover: hover) and (pointer: fine) {
    .nav-item:hover {
      transform: none;
    }
  }
</style>
