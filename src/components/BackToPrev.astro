---
import ArrowLeft from "lucide-astro/ArrowLeft";

type Props = {
  href: string;
}

const { href } = Astro.props;
---

<a href={href} class="relative group w-fit flex items-center gap-1.5 pl-3 pr-3 py-1.5 flex-nowrap rounded border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/20 dark:focus-visible:ring-white/30">
  <ArrowLeft
    size={16}
    stroke-width={2}
    aria-hidden="true"
    class="transition-transform duration-300 ease-in-out group-hover:-translate-x-0.5"
  />
  <div class="text-sm">
    <slot/>
  </div>
</a>
