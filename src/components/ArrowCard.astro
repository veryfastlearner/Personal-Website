---
import type { CollectionEntry } from "astro:content";
import ArrowRight from "lucide-astro/ArrowRight";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  locale?: "en" | "fr";
};

const { entry, locale = "en" } = Astro.props;
const base = locale === "fr" ? "/fr" : "";
const slug = entry.slug.replace(/^fr\//, "");
---

<a href={`${base}/${entry.collection}/${slug}`} class="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
  <div class="flex flex-col flex-1 truncate">
    <div class="font-semibold">
      {entry.data.title}
    </div>
    <div class="text-sm">
      {entry.data.description}
    </div>
  </div>
  <ArrowRight
    size={18}
    stroke-width={2}
    aria-hidden="true"
    class="absolute top-1/2 right-3 -translate-y-1/2 transition-transform duration-300 ease-in-out group-hover:translate-x-0.5"
  />
</a>
