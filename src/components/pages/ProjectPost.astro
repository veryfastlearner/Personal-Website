---
import type { CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import Link from "@components/Link.astro";
import { t, type Locale } from "@i18n";
import ExternalLink from "lucide-astro/ExternalLink";
import Github from "lucide-astro/Github";

type Props = {
  project: CollectionEntry<"projects">;
  locale: Locale;
};

const { project, locale } = Astro.props;
const { Content } = await project.render();
const base = locale === "fr" ? "/fr" : "";
---

<PageLayout title={project.data.title} description={project.data.description} locale={locale}>
  <Container>
    <div class="animate">
      <BackToPrev href={`${base}/projects`}>
        {t(locale, "backToProjects")}
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={project.data.date} locale={locale} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(project.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {project.data.title}
      </div>
      {(project.data.demoURL || project.data.repoURL) && (
        <nav class="animate flex gap-1">
          {project.data.demoURL && (
            <Link href={project.data.demoURL} external>
              <span class="inline-flex items-center gap-1">
                <ExternalLink size={16} stroke-width={1.75} aria-hidden="true" />
                {t(locale, "demo")}
              </span>
            </Link>
          )}
          {project.data.demoURL && project.data.repoURL && (
            <span class="px-1">/</span>
          )}
          {project.data.repoURL && (
            <Link href={project.data.repoURL} external>
              <span class="inline-flex items-center gap-1">
                <Github size={16} stroke-width={1.75} aria-hidden="true" />
                {t(locale, "repo")}
              </span>
            </Link>
          )}
        </nav>
      )}
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
