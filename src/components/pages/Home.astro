---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, SOCIALS } from "@consts";
import { t, type Locale } from "@i18n";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const base = locale === "fr" ? "/fr" : "";

const blog = (await getCollection("blog", (p) => p.data.lang === locale))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects", (p) => p.data.lang === locale))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work", (p) => p.data.lang === locale && p.data.featured))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={t(locale, "meta.home.title")} description={t(locale, "meta.home.description")} locale={locale}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      {t(locale, "home.greeting")}
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate font-semibold text-black dark:text-white">
            {t(locale, "home.title")}
          </p>
          <p class="animate">
            {t(locale, "home.summary")}
          </p>
        </article>
      </section>

      {blog.length > 0 && (
        <section class="animate space-y-6">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h5 class="font-semibold text-black dark:text-white">
              {t(locale, "section.latestPosts")}
            </h5>
            <Link href={`${base}/blog`}>
              {t(locale, "seeAll.posts")}
            </Link>
          </div>
          <ul class="flex flex-col gap-4">
            {blog.map(post => (
              <li>
                <ArrowCard entry={post} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )}

      {work.length > 0 && (
        <section class="animate space-y-6">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h5 class="font-semibold text-black dark:text-white">
              {t(locale, "section.workExperience")}
            </h5>
            <Link href={`${base}/work`}>
              {t(locale, "seeAll.work")}
            </Link>
          </div>
          <ul class="flex flex-col space-y-4">
            {work.map(entry => (
              <li>
                <div class="text-sm opacity-75">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd, locale)}
                </div>
                <div class="font-semibold text-black dark:text-white">
                  {entry.data.company}
                </div>
                <div class="text-sm opacity-75">
                  {entry.data.role}
                </div>
                <article>
                  <entry.Content />
                </article>
              </li>
            ))}
          </ul>
        </section>
      )}

      {projects.length > 0 && (
        <section class="animate space-y-6">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h5 class="font-semibold text-black dark:text-white">
              {t(locale, "section.recentProjects")}
            </h5>
            <Link href={`${base}/projects`}>
              {t(locale, "seeAll.projects")}
            </Link>
          </div>
          <ul class="flex flex-col gap-4">
            {projects.map(project => (
              <li>
                <ArrowCard entry={project} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          {t(locale, "section.letsConnect")}
        </h5>
        <article>
          <p>
            {t(locale, "connect.blurb")}
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
