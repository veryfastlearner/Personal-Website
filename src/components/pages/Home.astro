---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, SOCIALS } from "@consts";
import { t, type Locale } from "@i18n";
import Mail from "lucide-astro/Mail";

const githubIcon = {
  path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
};

const linkedinIcon = {
  path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037c-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85c3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.06 2.06 0 0 1-2.063-2.065a2.064 2.064 0 1 1 2.063 2.065m1.782 13.019H3.555V9h3.564zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z",
};

const socialIcons: Record<string, { path: string }> = {
  github: githubIcon,
  linkedin: linkedinIcon,
};

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const base = locale === "fr" ? "/fr" : "";

const blog = (await getCollection("blog", (p) => p.data.lang === locale))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects", (p) => p.data.lang === locale))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work", (p) => p.data.lang === locale && p.data.featured))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const siteURL = Astro.site ?? new URL(Astro.url.origin);
const description = t(locale, "meta.home.description");

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.NAME,
  email: `mailto:${SITE.EMAIL}`,
  url: siteURL.href,
  description,
  sameAs: SOCIALS.map((social) => social.HREF),
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.NAME,
  url: siteURL.href,
};
---

<PageLayout title={t(locale, "meta.home.title")} description={description} locale={locale} jsonLd={[person, website]}>
  <Container>
    <h1 class="animate font-semibold text-black dark:text-white">
      {t(locale, "home.greeting")}
    </h1>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate font-semibold text-black dark:text-white" style="--animate-index: 1">
            {t(locale, "home.title")}
          </p>
          <p class="animate" style="--animate-index: 1">
            {t(locale, "home.summary")}
          </p>
        </article>
      </section>

      {blog.length > 0 && (
        <section class="animate space-y-6" style="--animate-index: 2">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h2 class="font-semibold text-black dark:text-white">
              {t(locale, "section.latestPosts")}
            </h2>
            <Link href={`${base}/blog`}>
              {t(locale, "seeAll.posts")}
            </Link>
          </div>
          <ul class="flex flex-col gap-4">
            {blog.map(post => (
              <li>
                <ArrowCard entry={post} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )}

      {work.length > 0 && (
        <section class="animate space-y-6" style="--animate-index: 3">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h2 class="font-semibold text-black dark:text-white">
              {t(locale, "section.workExperience")}
            </h2>
            <Link href={`${base}/work`}>
              {t(locale, "seeAll.work")}
            </Link>
          </div>
          <ul class="flex flex-col space-y-4">
            {work.map(entry => (
              <li>
                <div class="text-sm opacity-75">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd, locale)}
                </div>
                <div class="font-semibold text-black dark:text-white">
                  {entry.data.company}
                </div>
                <div class="text-sm opacity-75">
                  {entry.data.role}
                </div>
                <article>
                  <entry.Content />
                </article>
              </li>
            ))}
          </ul>
        </section>
      )}

      {projects.length > 0 && (
        <section class="animate space-y-6" style="--animate-index: 4">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h2 class="font-semibold text-black dark:text-white">
              {t(locale, "section.recentProjects")}
            </h2>
            <Link href={`${base}/projects`}>
              {t(locale, "seeAll.projects")}
            </Link>
          </div>
          <ul class="flex flex-col gap-4">
            {projects.map(project => (
              <li>
                <ArrowCard entry={project} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="animate space-y-4" style="--animate-index: 5">
        <h2 class="font-semibold text-black dark:text-white">
          {t(locale, "section.letsConnect")}
        </h2>
        <article>
          <p>
            {t(locale, "connect.blurb")}
          </p>
        </article>
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
          {SOCIALS.map(SOCIAL => {
            const icon = socialIcons[SOCIAL.NAME];
            return (
              <li class="text-nowrap">
                <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                  <span class="inline-flex items-center gap-1.5">
                    {icon && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        class="size-[18px] fill-current"
                        aria-hidden="true"
                      >
                        <path d={icon.path} />
                      </svg>
                    )}
                    {SOCIAL.NAME}
                  </span>
                </Link>
              </li>
            );
          })}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              <span class="inline-flex items-center gap-1.5">
                <Mail size={18} stroke-width={1.75} aria-hidden="true" />
                {SITE.EMAIL}
              </span>
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
