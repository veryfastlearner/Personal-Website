---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
import Monitor from "lucide-astro/Monitor";
import Moon from "lucide-astro/Moon";
import Rss from "lucide-astro/Rss";
import Sun from "lucide-astro/Sun";

const iconButtonClass =
  "group size-8 flex items-center justify-center rounded-full text-black/50 dark:text-white/75 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/20 dark:focus-visible:ring-white/30";
---

<footer class="animate" style="--animate-index: 5">
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop />
      </div>
    </div>
    <div class="flex justify-between items-center">
      <div>
        &copy; 2026 {`|`} {SITE.NAME}
      </div>
      <div class="flex flex-wrap gap-1 items-center">
        <button
          id="light-theme-button"
          aria-label="Light theme"
          class={iconButtonClass}
        >
          <Sun size={18} stroke-width={1.5} aria-hidden="true" />
        </button>
        <button
          id="dark-theme-button"
          aria-label="Dark theme"
          class={iconButtonClass}
        >
          <Moon size={18} stroke-width={1.5} aria-hidden="true" />
        </button>
        <button
          id="system-theme-button"
          aria-label="System theme"
          class={iconButtonClass}
        >
          <Monitor size={18} stroke-width={1.5} aria-hidden="true" />
        </button>
        <a
          href="/rss.xml"
          aria-label="RSS feed"
          title="RSS feed"
          class={iconButtonClass}
        >
          <Rss size={18} stroke-width={1.5} aria-hidden="true" />
        </a>
      </div>
    </div>
  </Container>
</footer>
